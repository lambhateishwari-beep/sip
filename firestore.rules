rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace PASTE_OWNER_UID with the owner's Firebase Authentication UID.
    function owner() { return request.auth != null && request.auth.uid == 'PASTE_OWNER_UID'; }
    match /categories/{id} { allow read: true; allow write: owner(); }
    match /dishes/{id} { allow read: true; allow write: owner(); }
  }
}
